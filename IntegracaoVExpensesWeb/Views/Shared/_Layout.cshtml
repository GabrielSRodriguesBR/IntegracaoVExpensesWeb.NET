<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title1</title>
    <link href="~/Content/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/lib/fontawesome-free-6.5.2-web/css/all.css" rel="stylesheet" />
    <link href="~/Content/lib/fontawesome-free-6.5.2-web/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/lib/toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/Content/css/site.css" rel="stylesheet" />
    <script src="~/Content/lib/jquery/dist/jquery.min.js"></script>
    <style>

        input[type="checkbox"] {
            width: 23px;
            height: 23px;
            cursor: pointer;
        }

        .op-btn {
            width: 120px;
            display: flex;
            flex-wrap: wrap;
            flex-direction: column;
            align-items: flex-start;
        }

            .op-btn small {
                text-align: justify !important;
            }

        .icon-nok, .icon-ok {
            font-size: 15pt;
        }

        .icon-nok {
            color: #c92a2a;
        }

        .icon-ok {
            color: #36890d;
        }


        a.navbar-brand {
            white-space: normal;
            text-align: center;
            word-break: break-all;
        }

        a {
            color: #0077cc;
        }

        .btn-primary {
            color: #fff;
            background-color: #1b6ec2;
            border-color: #1861ac;
        }

        .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
            color: #fff;
            background-color: #1b6ec2;
            border-color: #1861ac;
        }

        .border-top {
            border-top: 1px solid #e5e5e5;
        }

        .border-bottom {
            border-bottom: 1px solid #e5e5e5;
        }

        .box-shadow {
            box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .05);
        }

        button.accept-policy {
            font-size: 1rem;
            line-height: inherit;
        }

        .footer {
            position: absolute;
            bottom: 0;
            width: 100%;
            white-space: nowrap;
            line-height: 60px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" href="/">Integracao VExpenses</a>

                <button class="btn btn-outline-dark" onclick="AbrirConfiguracoes()"><i class="fa fa-cog"></i></button>
        
            </div>
        </nav>
    </header>
    <div class="container-xxl">
        <main role="main" class="pb-3">
            <div class="title">
                @ViewBag.Title1
            </div>
            @RenderBody()
        </main>
    </div>



    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - IntegracaoVExpensesWeb
        </div>
    </footer>

    <script>

        const AbrirConfiguracoes = () => {
            $("body").append('<div class="modal fade" id="modalConfiguracoes" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true"></div>')
            $('#modalConfiguracoes').load("@Url.Action("ModalConfiguracoes", "Configuracoes")", () => {
                var modal = new bootstrap.Modal($('#modalConfiguracoes'));
                modal.show();
            })
            $('#modalConfiguracoes').on('hidden.bs.modal', () => {
                $('#modalConfiguracoes').remove();
            });
        }

        const BuscarApi = () => {
            $("body").append('<div class="modal fade" id="modalConsultaAPI" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true"></div>')
            $('#modalConsultaAPI').load("@Url.Action("ModalBuscarDadosApi", "Consulta")", () => {
                var modal = new bootstrap.Modal($('#modalConsultaAPI'));
                modal.show();
            })
            $('#modalConsultaAPI').on('hidden.bs.modal', () => {
                $('#modalConsultaAPI').remove();
            });
        }

        const SalvarResultados = () => {
            $('button').prop('disabled', true);

            $.post("@Url.Action("SalvarResultadosApi", "Consulta")", { resultadosAPI: resultadosAPI }, function (result){
                Alert(result.text, result.status);
            }, 'json')
            .fail(function (xhr, status, error) {
                Alert("Ocorreu um erro: " + error, false);
            }).always(function () {
                $('button').prop('disabled', false);
            });


        }


        const SalvarConfiguracao = () => {
            const formData = $('#formConfiguracao').serialize();
            const dialog = bootbox.dialog({
                message: '<p class="text-center mb-0"><i class="fa-solid fa-spin fa-gear"></i> Salvando...</p>',
                closeButton: false
            });


              setTimeout(() => {
                   $.post('/Configuracoes/SalvarConfiguracao', formData, (result) => {
                         dialog.modal('hide');
                         if (result.status) {
                             Alert(result.text, true);
                             $('#modalConfiguracoes').modal('hide');
                         } else {
                             Alert("Erro: " + result.text, false);
                         }
                   }).fail(() => {
                       dialog.modal('hide');
                       Alert("Erro ao salvar a configuração.", false);
                   });
              }, 700);


        };


    </script>


    <script src="~/Content/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/lib/toastr/toastr.min.js"></script>
    <script src="~/Content/js/site.js"></script>
    <script src="~/Content/lib/fontawesome-free-6.5.2-web/js/all.js"></script>
    <script src="~/Content/lib/fontawesome-free-6.5.2-web/js/all.min.js"></script>
    <script src="~/Content/lib/bootbox/bootbox.min.js"></script>
    <script src="~/Content/lib/bootbox/bootbox.locales.min.js"></script>
    @RenderSection("scripts", required: false)

</body>
</html>
